{
    "name": "df_silver_facturacion",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "ds_bronze_billing",
                        "type": "DatasetReference"
                    },
                    "name": "source1"
                },
                {
                    "dataset": {
                        "referenceName": "ds_silver_admissions",
                        "type": "DatasetReference"
                    },
                    "name": "source2"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "ds_silver_billing",
                        "type": "DatasetReference"
                    },
                    "name": "sink1"
                }
            ],
            "transformations": [
                {
                    "name": "derivedColumn1"
                },
                {
                    "name": "join1"
                }
            ],
            "scriptLines": [
                "source(output(",
                "    billing_id as string,",
                "    admission_id as string,",
                "    charge_type as string,",
                "    amount as string,",
                "    payment_status as string,",
                "    payment_date as string",
                "  ),",
                "  allowSchemaDrift: true,",
                "  validateSchema: false,",
                "  isolationLevel: 'READ_UNCOMMITTED',",
                "  format: 'table') ~> source1",
                "source(output(",
                "    admission_id as integer",
                "  ),",
                "  allowSchemaDrift: true,",
                "  validateSchema: false,",
                "  isolationLevel: 'READ_UNCOMMITTED',",
                "  format: 'table') ~> source2",
                "source1 derive(billing_id = toInteger(trim(billing_id)),",
                "    admission_id = toInteger(trim(admission_id)),",
                "    charge_type = iif(isNull(charge_type) || length(trim(charge_type)) == 0, 'Other', trim(charge_type)),",
                "    amount = iif(isNull(amount) || length(trim(replace(replace(replace(amount, 'USD', ''), '$', ''), ',', ''))) == 0, toDecimal('0.00', 12, 2), abs(toDecimal(trim(replace(replace(replace(amount, 'USD', ''), '$', ''), ',', '')), 12, 2))),",
                "    payment_status = case(lower(trim(payment_status)) == 'paid', 'Paid', lower(trim(payment_status)) == 'unpaid', 'Unpaid', lower(trim(payment_status)) == 'pending', 'Pending', lower(trim(payment_status)) == 'overdue', 'Overdue', 'Pending'),",
                "    payment_date = coalesce(toDate(trim(payment_date), 'yyyy-MM-dd'), toDate(trim(payment_date), 'MM/dd/yyyy'), toDate(trim(payment_date), 'MM-dd-yy'), toDate(trim(payment_date), 'dd-MMM-yyyy'), toDate(trim(payment_date), 'MMMM dd, yyyy'))) ~> derivedColumn1",
                "derivedColumn1, source2 join(derivedColumn1@admission_id == source2@admission_id,",
                "  joinType:'inner',",
                "  matchType:'exact',",
                "  ignoreSpaces: false,",
                "  broadcast: 'auto')~> join1",
                "join1 sink(allowSchemaDrift: true,",
                "  validateSchema: false,",
                "  input(",
                "    billing_id as integer,",
                "    admission_id as integer,",
                "    charge_type as string,",
                "    amount as decimal(12,2),",
                "    payment_status as string,",
                "    payment_date as date",
                "  ),",
                "  deletable:false,",
                "  insertable:true,",
                "  updateable:false,",
                "  upsertable:false,",
                "  format: 'table',",
                "  skipDuplicateMapInputs: true,",
                "  skipDuplicateMapOutputs: true,",
                "  mapColumn(",
                "    billing_id,",
                "    admission_id = derivedColumn1@admission_id,",
                "    charge_type,",
                "    amount,",
                "    payment_status,",
                "    payment_date",
                "  ),",
                "  errorHandlingOption: 'stopOnFirstError') ~> sink1"
            ]
        }
    }
}
